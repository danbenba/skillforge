{
  "name": "skillforge",
  "version": "1.0.0",
  "description": "SkillForge: search, compare and install Claude Agent Skills from claude.ai or Claude Code",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "skillforge": "./dist/index.js",
    "sf": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "dev": "tsx src/index.ts serve",
    "mcp": "node dist/index.js mcp",
    "serve": "node dist/index.js serve",
    "start": "node dist/index.js serve"
  },
  "files": [
    "dist",
    "docs",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "inquirer": "^12.5.2",
    "ora": "^8.2.0",
    "simple-git": "^3.33.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.30",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "skills",
    "package-manager",
    "mcp",
    "anthropic",
    "ai"
  ]
}
